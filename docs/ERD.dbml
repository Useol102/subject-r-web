// =====================================================================
// Subject R — 이동형 고령자 친화형 키오스크 / 전체 DB 설계 (초안 v2)
// dbdiagram.io 왼쪽 편집창에 통째로 붙여넣으면 그림이 나온다.
//
// 작성: 2026-09-17 · 기준 문서: 개발 계획서, CLAUDE.md, docs/ERD.md (상세 설명)
// 상태: 설계 초안. 아직 코드(web_api/models.py)에 반영하지 않았다.
//
// 공통 규칙 (자세한 이유는 docs/ERD.md §2)
//   - DB 엔진 : SQLite (팀 합의, 계획서 10번)
//   - 시각    : text, UTC, 형식 고정 YYYY-MM-DDTHH:MM:SS.sssZ (24자, JS toISOString 과 동일)
//   - 날짜    : *_day_kst text, YYYY-MM-DD, 한국 시간 기준 (오늘 필터·일자 집계용)
//   - 불리언  : SQLite 정수 0/1 + CHECK (x IN (0,1))
//   - 삭제    : 물리 삭제 금지. 마스터는 is_active=0, 로그는 추가만 한다.
//   - 개인정보: 회원번호·QR 원문 저장 금지. HMAC-SHA256 토큰만 저장.
//   - CHECK·부분 유니크 인덱스는 DBML 이 표현하지 못해 각 테이블 Note 에 적었다.
//     models.py 의 __table_args__ 에 전부 선언해야 한다 (PITFALLS B-1).
// =====================================================================

Project subject_r_web {
  database_type: 'SQLite'
  Note: '''
    이동형 고령자 친화형 키오스크 (월계종합사회복지관) 웹 + 서버 DB.
    테이블 23개 / 6개 영역. 1차(지금 구현) 17개, 2차(다른 팀 자료 대기) 6개.
  '''
}

// =====================================================================
// 1. 공간 — 층, 장소, 길찾기
// =====================================================================

Table floor {
  id integer [pk, increment]
  code text [not null, unique, note: '가져오기·API 식별자. 형식 예: B1, 1F']
  level integer [not null, unique, note: '층 순서. 지하1층=-1, 1층=1. 0 없음']
  label text [not null, note: '화면 표시. 형식 예: 지하 1층']
  has_elevator_stop boolean [not null, default: true, note: '엘리베이터가 서는 층인지 (로봇 층간 이동 가능 여부)']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차] 건물의 층.
    지금은 place.floor 정수로만 있어서 "지하 1층" 표기, 엘리베이터 정차 여부를 담을 곳이 없다.

    [CHECK] level <> 0
    [CHECK] level BETWEEN -10 AND 100
    [CHECK] is_active IN (0,1), has_elevator_stop IN (0,1)
  '''
}

Table place_category {
  id integer [pk, increment]
  code text [not null, unique, note: '영문 식별자']
  name text [not null, unique, note: '화면 표시. 현재 코드값: 안내, 강의실, 편의시설, 상담']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차] 장소 구분.
    지금은 schemas.py 에 Literal 로 박혀 있어서 구분을 추가하려면 코드를 고쳐야 한다.
    DB 관리 화면에서 직원이 추가할 수 있게 테이블로 뺀다.
  '''
}

Table place {
  id integer [pk, increment]
  code text [not null, unique, note: '가져오기 JSON·URL 용. 영문·숫자·-·_ 1~64자']
  floor_id integer [not null]
  category_id integer [not null]
  name text [not null, note: '1~100자']
  short_name text [note: '영수증·좁은 화면용 짧은 이름. 없으면 name']
  room_label text [note: '문 앞 실 번호 표지 그대로. 형식 예: 201호']
  description text [not null, default: '']
  accessibility text [not null, default: 'unknown', note: 'accessible / partial / not_accessible / unknown']
  accessibility_note text [note: '예: 문턱 있음, 경사로 이용']
  is_listed boolean [not null, default: true, note: '이용자 목록·검색에 보이는지']
  is_robot_reachable boolean [not null, default: false, note: '로봇 이동 목적지로 고를 수 있는지 (시뮬레이션팀 확인 후 1)']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  indexes {
    floor_id [name: 'ix_place_floor_id']
    category_id [name: 'ix_place_category_id']
  }

  Note: '''
    [1차] 이용자가 찾아가는 장소 (강의실, 화장실, 상담실 ...).

    wheelchair_accessible(true/false) 를 accessibility 4단계로 바꾼다.
    false 가 "휠체어 못 감" 인지 "아직 모름" 인지 구분이 안 되는 문제 때문이다.

    [CHECK] accessibility IN ('accessible','partial','not_accessible','unknown')
    [CHECK] length(name) BETWEEN 1 AND 100
    [CHECK] code GLOB 패턴 (영문·숫자·-·_)
    [부분 유니크] uq_place_floor_name_active : (floor_id, name) WHERE is_active = 1
               같은 층에 같은 이름의 활성 장소가 둘이면 이용자가 구분할 수 없다.
  '''
}

Table place_alias {
  id integer [pk, increment]
  place_id integer [not null]
  alias text [not null, note: '다르게 부르는 이름. 형식 예: 정식 명칭 대신 쓰는 통칭']
  alias_normalized text [not null, note: '공백 제거·소문자. hangulSearch.ts normalize() 와 같은 규칙']
  created_at text [not null]

  indexes {
    (place_id, alias_normalized) [unique, name: 'uq_place_alias']
    alias_normalized [name: 'ix_place_alias_normalized']
  }

  Note: '''
    [1차] 장소 검색용 별칭.
    어르신이 공식 이름과 다르게 부르는 경우를 받아준다.
    search_log 에서 "결과 0건" 검색어를 보고 직원이 여기에 추가하는 흐름.
  '''
}

Table inquiry_topic {
  id integer [pk, increment]
  code text [not null, unique]
  question text [not null, note: '이용자가 누르는 질문 문장']
  answer text [not null, default: '', note: '짧은 답. 장소 안내가 필요 없으면 이것만']
  place_id integer [note: '안내할 장소. 없으면 answer 만 보여준다']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차] 계획서 3-1 "문의 장소와 해당 장소 길찾기".
    "무엇을 어디서 하나요?" 식 질문 → 담당 장소 연결.
    질문 문구는 기관에서 받아 채운다. 임의로 지어 넣지 않는다.
  '''
}

Table route {
  id integer [pk, increment]
  from_place_id integer [not null, note: '출발 위치 = 키오스크(로봇)가 서 있는 장소']
  to_place_id integer [not null]
  is_barrier_free boolean [not null, default: false, note: '계단·문턱 없이 갈 수 있는 경로인지']
  uses_elevator boolean [not null, default: false]
  estimated_minutes integer [note: '어르신 걸음 기준 예상 시간']
  verification text [not null, default: 'draft', note: 'draft / staff_checked / simulation_verified']
  verified_at text
  verified_by_staff_id integer
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  indexes {
    to_place_id [name: 'ix_route_to_place_id']
  }

  Note: '''
    [1차] 길찾기 안내문 한 벌 = 출발지 → 도착지.
    지금은 place.directions(JSON) 하나뿐이라 출발지가 없다.
    계획서 7번 "이동 후 현재 위치에 맞는 안내 재개" → 로봇이 옮겨지면 출발지가 달라지므로 분리한다.

    [CHECK] from_place_id <> to_place_id
    [CHECK] verification IN ('draft','staff_checked','simulation_verified')
    [CHECK] estimated_minutes IS NULL OR estimated_minutes BETWEEN 1 AND 120
    [CHECK] verification = 'draft' OR verified_at IS NOT NULL
    [부분 유니크] uq_route_active : (from_place_id, to_place_id, is_barrier_free) WHERE is_active = 1
  '''
}

Table route_step {
  id integer [pk, increment]
  route_id integer [not null]
  step_no integer [not null, note: '1부터']
  instruction text [not null, note: '한 단계 안내 문장. 1~200자']
  floor_id integer [note: '이 단계가 일어나는 층 (엘리베이터 전후 표시용)']
  landmark text [note: '눈에 띄는 표지. 예: 엘리베이터 앞 게시판']
  image_uri text [note: '사진 파일 경로. 파일은 DB 에 넣지 않는다']
  created_at text [not null]
  updated_at text [not null]

  indexes {
    (route_id, step_no) [unique, name: 'uq_route_step_no']
  }

  Note: '''
    [1차] 길찾기 단계. 화면 목록과 영수증 인쇄에 그대로 쓴다.

    [CHECK] step_no BETWEEN 1 AND 30
    [CHECK] length(instruction) BETWEEN 1 AND 200
  '''
}

Table floor_map {
  id integer [pk, increment]
  floor_id integer [not null]
  version integer [not null, note: '층마다 1부터 증가. 덮어쓰지 않는다']
  source text [not null, note: 'slam / drawing']
  image_uri text [not null, note: '파일 경로. bytea/BLOB 금지']
  image_sha256 text [not null]
  width_px integer
  height_px integer
  meters_per_px real [note: 'SLAM 해상도. 시뮬레이션팀 규격 대기']
  origin_x real
  origin_y real
  is_active boolean [not null, default: false]
  note text
  created_at text [not null]

  indexes {
    (floor_id, version) [unique, name: 'uq_floor_map_version']
  }

  Note: '''
    [2차 · 시뮬레이션팀 지도 대기] 층별 실내 지도의 한 버전.
    지도를 다시 만들면 좌표계가 바뀌므로 새 행으로 넣는다 (옛 설계의 교훈).

    [CHECK] source IN ('slam','drawing')
    [CHECK] length(image_sha256) = 64
    [부분 유니크] uq_floor_map_active : (floor_id) WHERE is_active = 1  — 층마다 활성 지도 하나
  '''
}

Table place_map_point {
  id integer [pk, increment]
  place_id integer [not null]
  floor_map_id integer [not null]
  point_kind text [not null, note: 'entrance / robot_stop']
  x real [not null]
  y real [not null]
  yaw real [note: '로봇이 멈출 때 바라볼 방향 (라디안)']
  created_at text [not null]
  updated_at text [not null]

  indexes {
    (place_id, floor_map_id, point_kind) [unique, name: 'uq_place_map_point']
  }

  Note: '''
    [2차 · 시뮬레이션팀 규격 대기] 장소의 지도 위 좌표.
    지도 버전마다 좌표가 다르므로 place 에 x,y 를 두지 않고 따로 뺀다.
    좌표 단위(미터/픽셀)는 규격을 받은 뒤 확정한다.

    [CHECK] point_kind IN ('entrance','robot_stop')
    [앱 검증] floor_map.floor_id = place.floor_id
  '''
}

// =====================================================================
// 2. 프로그램 — 강좌·행사와 회차
// =====================================================================

Table program_category {
  id integer [pk, increment]
  code text [not null, unique]
  name text [not null, unique, note: '현재 코드값: 건강, 문화, 디지털, 행사']
  color_token text [note: '화면 태그 색 이름. CSS 값 직접 저장 X']
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차] 프로그램 구분. place_category 와 같은 이유로 테이블로 뺀다.
  '''
}

Table program {
  id integer [pk, increment]
  code text [not null, unique]
  category_id integer [not null]
  kind text [not null, default: 'class', note: 'class(정기 강좌) / event(일회성 행사)']
  title text [not null, note: '1~100자']
  description text [not null, default: '']
  instructor_name text [not null, default: '', note: '강사 이름만. 연락처 저장 X']
  target_audience text [note: '대상 설명 문구']
  default_place_id integer [note: '회차 만들 때 기본 장소']
  capacity integer [note: '정원. 표시용. 신청 관리는 기관 시스템']
  requires_registration boolean [not null, default: false, note: '사전 신청 필요 표시']
  external_ref text [note: '기관 시스템의 프로그램 ID (연동 규격 대기)']
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  indexes {
    category_id [name: 'ix_program_category_id']
  }

  Note: '''
    [1차] 강좌·행사 "그 자체" (무엇을 하는가).
    언제·어디서는 program_session 에 둔다.
    지금은 program 한 행에 시간이 붙어 있어 매주 하는 강좌를 매번 새로 등록해야 한다.

    [CHECK] kind IN ('class','event')
    [CHECK] capacity IS NULL OR capacity BETWEEN 1 AND 1000
    [CHECK] length(title) BETWEEN 1 AND 100
    [부분 유니크] uq_program_external_ref : (external_ref) WHERE external_ref IS NOT NULL
  '''
}

Table program_session {
  id integer [pk, increment]
  program_id integer [not null]
  place_id integer [not null]
  starts_at text [not null, note: 'UTC']
  ends_at text [not null, note: 'UTC']
  session_day_kst text [not null, note: 'starts_at 의 한국 날짜. 오늘 필터 인덱스용']
  status text [not null, default: 'scheduled', note: 'scheduled / canceled']
  cancel_reason text
  attendance_open_minutes integer [note: '시작 몇 분 전부터 출석 받나. NULL 이면 setting 값']
  needs_robot_prep boolean [not null, default: false, note: '시작 전 로봇을 강의실 앞으로 보낼지 (계획서 5번)']
  note text
  created_at text [not null]
  updated_at text [not null]

  indexes {
    (program_id, starts_at) [unique, name: 'uq_program_session_start']
    (session_day_kst, starts_at) [name: 'ix_program_session_day']
    (place_id, starts_at) [name: 'ix_program_session_place']
  }

  Note: '''
    [1차] 프로그램의 한 회차 (언제·어디서).
    출석·예약 이동·인쇄는 전부 회차 기준이다.

    [CHECK] ends_at > starts_at            (형식이 고정이라 문자열 비교가 곧 시각 비교)
    [CHECK] status IN ('scheduled','canceled')
    [CHECK] status = 'scheduled' OR cancel_reason IS NOT NULL
    [CHECK] attendance_open_minutes IS NULL OR attendance_open_minutes BETWEEN 0 AND 180
    [CHECK] starts_at / ends_at / session_day_kst 형식 GLOB
    [앱 검증] 같은 장소·겹치는 시간의 scheduled 회차 경고 (SQLite 로 막기 어려움)
  '''
}

// =====================================================================
// 3. 출결
// =====================================================================

Table attendance {
  id integer [pk, increment]
  program_session_id integer [not null]
  member_token text [not null, note: 'HMAC-SHA256(서버 비밀키, 회원 코드) 16진수 64자. 원문 저장 금지']
  method text [not null, note: 'barcode / qr / manual']
  result text [not null, note: 'accepted / duplicate / rejected']
  reject_reason text [note: 'not_open_yet / closed / session_canceled / unknown_member / invalid_code']
  robot_id integer [note: '어느 키오스크에서 찍었나']
  checked_at text [not null]
  checked_day_kst text [not null]
  sync_status text [not null, note: 'not_required / pending / sent / failed']
  synced_at text
  sync_error text
  external_ref text [note: '기관 출결 시스템이 돌려준 ID (규격 대기)']
  is_simulated boolean [not null, default: true]
  created_at text [not null]

  indexes {
    (program_session_id, checked_at) [name: 'ix_attendance_session']
    (sync_status, checked_at) [name: 'ix_attendance_sync']
    checked_day_kst [name: 'ix_attendance_day']
  }

  Note: '''
    [1차] 출석 시도 한 번 = 한 행 (성공·중복·거절 모두 남긴다).
    기관 출결 시스템이 원본이고, 우리는 "찍은 기록 + 전송 상태" 를 가진다.

    회원번호가 숫자 몇 자리면 SHA-256 만으로는 전수 대입으로 원문이 복원된다.
    → 서버만 아는 비밀키로 HMAC 을 쓴다. (현재 코드는 평문 SHA-256 — 바꿔야 함)

    [CHECK] method IN ('barcode','qr','manual')
    [CHECK] result IN ('accepted','duplicate','rejected')
    [CHECK] (result = 'rejected') = (reject_reason IS NOT NULL)
    [CHECK] sync_status IN ('not_required','pending','sent','failed')
    [CHECK] result = 'accepted' OR sync_status = 'not_required'
    [CHECK] length(member_token) = 64
    [부분 유니크] uq_attendance_accepted : (program_session_id, member_token) WHERE result = 'accepted'
                한 회차에 같은 회원의 "성공" 은 하나만. 중복 스캔은 duplicate 행으로 남는다.
  '''
}

// =====================================================================
// 4. 로봇·이동 (trip)
// =====================================================================

Table robot {
  id integer [pk, increment]
  code text [not null, unique]
  name text [not null]
  model text
  home_place_id integer [not null, note: '평소 대기 장소 (계획서 5번: 로비 배치)']
  current_place_id integer [note: '마지막으로 확인된 장소. 모르면 NULL']
  current_floor_id integer
  state text [not null, default: 'offline', note: 'offline / idle / moving / charging / error / estop']
  battery_pct integer
  last_seen_at text
  api_key_hash text [unique, note: '로봇 인증키 SHA-256. bcrypt 금지 (조회 불가)']
  connection text [not null, default: 'simulated', note: 'simulated / real']
  is_active boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차] 이동형 키오스크 한 대 = 로봇 한 대. 지금 1대지만 N대 구조로 둔다.

    [CHECK] state IN ('offline','idle','moving','charging','error','estop')
    [CHECK] connection IN ('simulated','real')
    [CHECK] battery_pct IS NULL OR battery_pct BETWEEN 0 AND 100
    [CHECK] api_key_hash IS NULL OR length(api_key_hash) = 64
  '''
}

Table robot_status_log {
  id integer [pk, increment]
  robot_id integer [not null]
  recorded_at text [not null]
  recorded_day_kst text [not null]
  state text [not null]
  battery_pct integer
  floor_id integer
  place_id integer
  floor_map_id integer
  x real
  y real
  payload json [note: '로봇이 보낸 나머지 값 그대로']

  indexes {
    (robot_id, recorded_at) [name: 'ix_robot_status_log']
  }

  Note: '''
    [2차 · 로봇 상태 API 규격 대기] 로봇 상태 기록.
    1초마다 쌓으면 SQLite 가 금방 커진다 → "상태가 바뀔 때 + N초마다" 만 저장, 보존기간 후 정리.
    (정리는 물리 삭제지만 마스터가 아닌 로그라 예외. 보존기간은 결정 필요)

    [CHECK] state IN ('offline','idle','moving','charging','error','estop')
    [CHECK] battery_pct IS NULL OR battery_pct BETWEEN 0 AND 100
    [CHECK] (x IS NULL) = (y IS NULL) AND (x IS NULL OR floor_map_id IS NOT NULL)
  '''
}

Table trip {
  id integer [pk, increment]
  public_id text [not null, unique, note: 'UUID. 로봇·시뮬레이션팀과 주고받는 ID']
  robot_id integer [not null]
  purpose text [not null, note: 'staff_request / program_prep / return_home / test']
  origin_place_id integer [note: '출발 당시 장소. 모르면 NULL']
  destination_place_id integer [not null]
  program_session_id integer [note: 'program_prep 일 때 어느 회차 준비인지']
  requested_by_staff_id integer [note: '직원이 요청했으면 누구인지']
  status text [not null, note: 'scheduled / requested / moving / arrived / canceled / failed']
  scheduled_for text [note: '예약 이동: 이 시각에 requested 로 바뀐다']
  requested_at text
  started_at text
  arrived_at text
  ended_at text [note: 'arrived / canceled / failed 가 된 시각']
  cancel_reason text
  failure_reason text
  is_simulated boolean [not null, default: true]
  created_at text [not null]
  updated_at text [not null]

  indexes {
    (robot_id, created_at) [name: 'ix_trip_robot']
    (status, scheduled_for) [name: 'ix_trip_scheduled']
  }

  Note: '''
    [1차] 로봇 이동 요청 1건. "mission", "task" 라고 부르지 않는다.

    [CHECK] purpose IN ('staff_request','program_prep','return_home','test')
    [CHECK] status IN ('scheduled','requested','moving','arrived','canceled','failed')
    [CHECK] purpose <> 'program_prep' OR program_session_id IS NOT NULL
    [CHECK] status <> 'scheduled' OR scheduled_for IS NOT NULL
    [CHECK] status NOT IN ('arrived','canceled','failed') OR ended_at IS NOT NULL
    [CHECK] status <> 'canceled' OR cancel_reason IS NOT NULL
    [CHECK] status <> 'failed' OR failure_reason IS NOT NULL
    [CHECK] origin_place_id IS NULL OR origin_place_id <> destination_place_id
    [부분 유니크] uq_trip_robot_active : (robot_id) WHERE status IN ('requested','moving')
                로봇 한 대에 실제로 진행 중인 이동은 하나만. (지금 코드에도 있음)
    [부분 유니크] uq_trip_session_prep : (program_session_id)
                WHERE purpose = 'program_prep' AND status IN ('scheduled','requested','moving')
                한 회차 준비 이동이 두 번 잡히지 않게.
  '''
}

Table trip_event {
  id integer [pk, increment]
  trip_id integer [not null]
  occurred_at text [not null]
  event_type text [not null]
  from_status text
  to_status text
  floor_id integer [note: '엘리베이터 이벤트의 층']
  source text [not null, note: 'web / robot / simulation']
  actor_staff_id integer
  message text [note: '직원 화면에 보여줄 한 줄']
  payload json [note: '로봇이 보낸 원본 값']
  created_at text [not null]

  indexes {
    (trip_id, occurred_at) [name: 'ix_trip_event_trip']
  }

  Note: '''
    [1차: status_changed · note / 2차: 엘리베이터·장애물 이벤트는 로봇 규격 대기]
    trip 진행 기록. 추가만 한다.
    엘리베이터 종류는 계획서 6번 절차 순서를 따른다.

    [CHECK] event_type IN ('status_changed','note',
                           'elevator_called','elevator_boarded','floor_reached','door_opened','elevator_exited',
                           'obstacle_detected','estop','error')
    [CHECK] source IN ('web','robot','simulation')
    [CHECK] (event_type = 'status_changed') = (to_status IS NOT NULL)
  '''
}

// =====================================================================
// 5. 이용자 지원 — 도움 요청, 인쇄, 검색 기록
// =====================================================================

Table help_request {
  id integer [pk, increment]
  robot_id integer [note: '어느 키오스크에서 눌렀나']
  place_id integer [note: '누른 당시 키오스크 위치']
  reason text [not null, default: 'general', note: 'general / lost / printer / attendance']
  status text [not null, default: 'open', note: 'open / acknowledged / resolved / canceled']
  requested_at text [not null]
  acknowledged_at text
  acknowledged_by_staff_id integer
  resolved_at text
  resolved_by_staff_id integer
  staff_note text
  created_at text [not null]
  updated_at text [not null]

  indexes {
    (status, requested_at) [name: 'ix_help_request_status']
  }

  Note: '''
    [2차 · 기능 범위 확인 필요] 이용자가 화면에서 "직원 불러주세요" 를 누른 기록.
    지금 화면은 "호출이 전송되지 않아요" 로 안내만 한다.
    개인정보(이름·전화)는 받지 않는다.

    [CHECK] reason IN ('general','lost','printer','attendance')
    [CHECK] status IN ('open','acknowledged','resolved','canceled')
    [CHECK] status = 'open' OR acknowledged_at IS NOT NULL OR status = 'canceled'
    [CHECK] status <> 'resolved' OR resolved_at IS NOT NULL
  '''
}

Table print_job {
  id integer [pk, increment]
  robot_id integer
  content_type text [not null, note: 'program_session / place / route']
  program_session_id integer
  place_id integer
  route_id integer
  content_snapshot json [not null, note: '인쇄 당시 내용 그대로. 개인정보 금지']
  printer_name text [note: '프린터 기종 확정 후 사용']
  status text [not null, default: 'requested', note: 'requested / printed / failed']
  error text
  requested_at text [not null]
  requested_day_kst text [not null]
  created_at text [not null]

  indexes {
    (requested_day_kst, content_type) [name: 'ix_print_job_day']
  }

  Note: '''
    [2차 · 프린터 기종 대기] 영수증 인쇄 요청 기록.
    브라우저 window.print() 는 실제로 뽑혔는지 알 수 없다 → 지금은 requested 만 남는다.
    전용 프린터 연동이 되면 printed / failed 를 채운다.

    [CHECK] content_type IN ('program_session','place','route')
    [CHECK] status IN ('requested','printed','failed')
    [CHECK] content_type <> 'program_session' OR program_session_id IS NOT NULL
    [CHECK] content_type <> 'place' OR place_id IS NOT NULL
    [CHECK] content_type <> 'route' OR route_id IS NOT NULL
  '''
}

Table search_log {
  id integer [pk, increment]
  robot_id integer
  screen text [not null, note: 'place / program']
  query_normalized text [not null, note: '정규화한 검색어. 50자 제한']
  result_count integer [not null]
  selected_place_id integer [note: '검색 후 실제로 누른 장소']
  searched_at text [not null]
  searched_day_kst text [not null]

  indexes {
    (searched_day_kst, result_count) [name: 'ix_search_log_day']
  }

  Note: '''
    [2차 · 보존기간 결정 필요] 키오스크 검색 기록.
    목적: "결과 0건" 검색어를 모아 place_alias 를 보강한다.
    자판 입력 한 글자마다가 아니라 결과 화면을 벗어날 때 한 번만 남긴다.

    [CHECK] screen IN ('place','program')
    [CHECK] length(query_normalized) BETWEEN 1 AND 50
    [CHECK] result_count >= 0
  '''
}

// =====================================================================
// 6. 직원 계정·운영
// =====================================================================

Table staff {
  id integer [pk, increment]
  login_id text [not null, unique, note: '영문·숫자. 이메일일 필요 없음']
  display_name text [not null]
  password_hash text [not null, note: 'bcrypt 직접 호출. passlib 금지']
  role text [not null, default: 'staff', note: 'admin / staff / viewer']
  is_active boolean [not null, default: true]
  failed_login_count integer [not null, default: 0]
  locked_until text
  last_login_at text
  password_changed_at text [not null]
  created_at text [not null]
  updated_at text [not null]

  Note: '''
    [1차 · 방식 결정 필요] 직원 계정.
    지금은 WEB_ADMIN_KEY 공용 키 하나라 "누가 바꿨는지" 를 남길 수 없다.
    권한 위계 admin > staff > viewer (옛 설계와 동일).

    [CHECK] role IN ('admin','staff','viewer')
    [CHECK] failed_login_count >= 0
  '''
}

Table audit_log {
  id integer [pk, increment]
  staff_id integer [note: 'NULL = 시스템·가져오기·로봇']
  action text [not null, note: 'create / update / deactivate / reactivate / import / login / login_failed']
  table_name text [note: '대상 테이블. 로그인은 NULL']
  row_id integer
  before_json json [note: '바뀌기 전 값. 민감 컬럼 제외']
  after_json json
  client_ip text
  occurred_at text [not null]

  indexes {
    (table_name, row_id, occurred_at) [name: 'ix_audit_log_row']
    occurred_at [name: 'ix_audit_log_time']
  }

  Note: '''
    [1차] DB 관리 화면에서 일어난 변경 기록. 추가만 한다 (수정·삭제 API 없음).
    password_hash, member_token, api_key_hash 는 before/after 에 넣지 않는다.

    [CHECK] action IN ('create','update','deactivate','reactivate','import','login','login_failed')
    [CHECK] action IN ('login','login_failed') OR table_name IS NOT NULL
  '''
}

Table setting {
  key text [pk, note: '점 구분 이름. 예: kiosk.idle_reset_seconds']
  value_json json [not null]
  description text [not null]
  updated_at text [not null]
  updated_by_staff_id integer

  Note: '''
    [1차] 코드에 박혀 있던 운영 값.
    처음 넣을 키 (현재 코드의 실제 값):
      kiosk.idle_reset_seconds          = 180   (App.tsx 180000ms)
      attendance.open_minutes_before    = 30    (scanner.ts graceMinutes)
      scanner.max_key_interval_ms       = 50    (scanner.ts)
      trip.program_prep_minutes_before  = 결정 필요
      receipt.paper_width_mm            = 80    (styles.css, 프린터 확정 전 가정)
      receipt.footer_text               = 기관 문구 대기
  '''
}

// =====================================================================
// 관계 (ON DELETE — 물리 삭제를 안 하므로 대부분 restrict)
// =====================================================================

// 공간
Ref: place.floor_id > floor.id [delete: restrict]
Ref: place.category_id > place_category.id [delete: restrict]
Ref: place_alias.place_id > place.id [delete: cascade]
Ref: inquiry_topic.place_id > place.id [delete: restrict]
Ref: route.from_place_id > place.id [delete: restrict]
Ref: route.to_place_id > place.id [delete: restrict]
Ref: route.verified_by_staff_id > staff.id [delete: restrict]
Ref: route_step.route_id > route.id [delete: cascade]
Ref: route_step.floor_id > floor.id [delete: restrict]
Ref: floor_map.floor_id > floor.id [delete: restrict]
Ref: place_map_point.place_id > place.id [delete: cascade]
Ref: place_map_point.floor_map_id > floor_map.id [delete: restrict]

// 프로그램
Ref: program.category_id > program_category.id [delete: restrict]
Ref: program.default_place_id > place.id [delete: restrict]
Ref: program_session.program_id > program.id [delete: restrict]
Ref: program_session.place_id > place.id [delete: restrict]

// 출결
Ref: attendance.program_session_id > program_session.id [delete: restrict]
Ref: attendance.robot_id > robot.id [delete: restrict]

// 로봇·이동
Ref: robot.home_place_id > place.id [delete: restrict]
Ref: robot.current_place_id > place.id [delete: restrict]
Ref: robot.current_floor_id > floor.id [delete: restrict]
Ref: robot_status_log.robot_id > robot.id [delete: restrict]
Ref: robot_status_log.floor_id > floor.id [delete: restrict]
Ref: robot_status_log.place_id > place.id [delete: restrict]
Ref: robot_status_log.floor_map_id > floor_map.id [delete: restrict]
Ref: trip.robot_id > robot.id [delete: restrict]
Ref: trip.origin_place_id > place.id [delete: restrict]
Ref: trip.destination_place_id > place.id [delete: restrict]
Ref: trip.program_session_id > program_session.id [delete: restrict]
Ref: trip.requested_by_staff_id > staff.id [delete: restrict]
Ref: trip_event.trip_id > trip.id [delete: restrict]
Ref: trip_event.floor_id > floor.id [delete: restrict]
Ref: trip_event.actor_staff_id > staff.id [delete: restrict]

// 이용자 지원
Ref: help_request.robot_id > robot.id [delete: restrict]
Ref: help_request.place_id > place.id [delete: restrict]
Ref: help_request.acknowledged_by_staff_id > staff.id [delete: restrict]
Ref: help_request.resolved_by_staff_id > staff.id [delete: restrict]
Ref: print_job.robot_id > robot.id [delete: restrict]
Ref: print_job.program_session_id > program_session.id [delete: restrict]
Ref: print_job.place_id > place.id [delete: restrict]
Ref: print_job.route_id > route.id [delete: restrict]
Ref: search_log.robot_id > robot.id [delete: restrict]
Ref: search_log.selected_place_id > place.id [delete: restrict]

// 운영
Ref: audit_log.staff_id > staff.id [delete: restrict]
Ref: setting.updated_by_staff_id > staff.id [delete: restrict]

// =====================================================================
// 그룹 (dbdiagram 에서 색 상자로 묶인다)
// =====================================================================

TableGroup "1. 공간" {
  floor
  place_category
  place
  place_alias
  inquiry_topic
  route
  route_step
  floor_map
  place_map_point
}

TableGroup "2. 프로그램" {
  program_category
  program
  program_session
}

TableGroup "3. 출결" {
  attendance
}

TableGroup "4. 로봇·이동" {
  robot
  robot_status_log
  trip
  trip_event
}

TableGroup "5. 이용자 지원" {
  help_request
  print_job
  search_log
}

TableGroup "6. 직원·운영" {
  staff
  audit_log
  setting
}
