# 복사해서 .env 로 쓸 것:   copy .env.example .env
# .env 는 git에 올리지 않는다 (.gitignore에 포함됨)

# --- PostgreSQL을 Windows에 직접 설치한 경우 (가상화 불필요) ---
# 설치 마법사에서 정한 postgres 비밀번호로 바꿀 것
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_DB=robotdb
POSTGRES_PORT=5432

# 백엔드 연결 문자열 — psycopg3이므로 +psycopg (뒤에 2를 붙이지 말 것)
DATABASE_URL=postgresql+psycopg://postgres:devpass@localhost:5432/robotdb

# --- Docker로 띄우는 팀원은 위 3줄을 아래로 바꿔 쓸 것 ---
# POSTGRES_USER=robot
# POSTGRES_PASSWORD=devpass
# DATABASE_URL=postgresql+psycopg://robot:devpass@localhost:5432/robotdb

# 반드시 32바이트 이상. 아래로 새로 뽑아서 교체할 것:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- 2차(MinIO, AI 학습 이미지 저장) 사용 시에만 ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=sbr-data
